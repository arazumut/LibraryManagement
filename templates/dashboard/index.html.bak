{% extends 'layouts/base.html' %}
{% load static %}

{% block title %}Gösterge Paneli | Kütüphane Yönetim Sistemi{% endblock %}

{% block content %}
<!-- Dashboard Başlık -->
<div class="dashboard-heading px-3 mb-5">
    <h1 class="dashboard-title">Merhaba, {{ user.first_name|default:user.username }}!</h1>
    <p class="dashboard-subtitle">Kütüphane yönetim sistemine hoş geldiniz. İşte genel bir bakış.</p>
</div>

<!--begin::Row-->
<div class="row g-4 mb-5">
    <!--begin::Col-->
    <div class="col-md-6 col-lg-6 col-xl-6 col-xxl-3">
        <!--begin::Card widget -->
        <div class="card dashboard-card h-100">
            <!--begin::Card body-->
            <div class="card-body p-4">
                <div class="d-flex flex-column">
                    <!--begin::Icon-->
                    <div class="mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-light-primary w-65px h-65px rounded-circle">
                            <i class="ki-outline ki-book fs-1 text-primary"></i>
                        </div>
                    </div>
                    <!--end::Icon-->
                    <!--begin::Content-->
                    <div class="d-flex flex-column mb-4">
                        <span class="dashboard-number">{{ total_books }}</span>
                        <span class="dashboard-label">Toplam Kitap</span>
                    </div>
                    <!--end::Content-->
                    <!--begin::Stats-->
                    <div class="d-flex flex-column">
                        <div class="stat-item">
                            <div class="stat-bullet bg-success"></div>
                            <div class="stat-label">Mevcut</div>
                            <div class="stat-value">{{ available_books }}</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-bullet bg-primary"></div>
                            <div class="stat-label">Ödünç Verilmiş</div>
                            <div class="stat-value">{{ borrowed_books }}</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-bullet bg-danger"></div>
                            <div class="stat-label">Rezerve Edilmiş</div>
                            <div class="stat-value">{{ reserved_books }}</div>
                        </div>
                    </div>
                    <!--end::Stats-->
                </div>
            </div>
            <!--end::Card body-->
        </div>
        <!--end::Card widget-->
    </div>
    <!--end::Col-->
    
    <!--begin::Col-->
    <div class="col-md-6 col-lg-6 col-xl-6 col-xxl-3">
        <!--begin::Card widget -->
        <div class="card dashboard-card h-100">
            <!--begin::Card body-->
            <div class="card-body p-4">
                <div class="d-flex flex-column">
                    <!--begin::Icon-->
                    <div class="mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-light-success w-65px h-65px rounded-circle">
                            <i class="ki-outline ki-handcart fs-1 text-success"></i>
                        </div>
                    </div>
                    <!--end::Icon-->
                    <!--begin::Content-->
                    <div class="d-flex flex-column mb-4">
                        <span class="dashboard-number">{{ total_loans }}</span>
                        <span class="dashboard-label">Aktif Ödünçler</span>
                    </div>
                    <!--end::Content-->
                    
                    <!--begin::Chart-->
                    <div class="mb-3">
                        <h6 class="fw-bold mb-3">Ödünç Durumu</h6>
                        <div id="kt_card_widget_7_chart" class="min-h-auto" style="height: 100px"></div>
                    </div>
                    <!--end::Chart-->
                </div>
            </div>
            <!--end::Card body-->
        </div>
        <!--end::Card widget-->
    </div>
    <!--end::Col-->
    
    <!--begin::Col-->
    <div class="col-md-6 col-lg-6 col-xl-6 col-xxl-3">
        <!--begin::Card widget -->
        <div class="card dashboard-card h-100">
            <!--begin::Card body-->
            <div class="card-body p-4">
                <div class="d-flex flex-column">
                    <!--begin::Icon-->
                    <div class="mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-light-info w-65px h-65px rounded-circle">
                                <i class="ki-outline ki-abstract-26 fs-1 text-info"></i>
                            </div>
                        </div>
                        <!--end::Icon-->
                        <!--begin::Content-->
                        <div class="d-flex flex-column mb-4">
                            <span class="dashboard-number">{{ total_libraries }}</span>
                            <span class="dashboard-label">Toplam Kütüphane</span>
                        </div>
                        <!--end::Content-->
                        <!--begin::Stats-->
                        <div class="d-flex flex-column">
                            <div class="stat-item">
                                <div class="stat-bullet bg-info"></div>
                                <div class="stat-label">Kütüphaneleriniz</div>
                                <div class="stat-value">{{ user_libraries }}</div>
                            </div>
                            <div class="stat-item">
                                <div class="stat-bullet bg-success"></div>
                                <div class="stat-label">Kütüphane Kitapları</div>
                                <div class="stat-value">{{ user_library_books }}</div>
                            </div>
                        </div>
                        <!--end::Stats-->
                    </div>
                </div>
                <!--end::Card body-->
            </div>
            <!--end::Card widget-->
        <div class="col-md-6 col-lg-6 col-xl-6 col-xxl-3">
            <!--begin::Card widget -->
            <div class="card dashboard-card h-100">
                <!--begin::Card body-->
                <div class="card-body p-4">
                    <div class="d-flex flex-column">
                        <!--begin::Icon-->
                        <div class="mb-4">
                            <div class="d-inline-flex align-items-center justify-content-center bg-light-warning w-65px h-65px rounded-circle">
                                <i class="ki-outline ki-notification-status fs-1 text-warning"></i>
                            </div>
                        </div>
                        <!--end::Icon-->
                        <!--begin::Content-->
                        <div class="d-flex flex-column mb-4">
                            <span class="dashboard-number">{{ pending_requests }}</span>
                            <span class="dashboard-label">Bekleyen İstekler</span>
                        </div>
                        <!--end::Content-->
                        
                        <!--begin::Progress-->
                        <div class="mt-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fs-7 fw-bold text-gray-600">İstek Başarı Oranı</span>
                                <span class="fs-7 fw-bolder text-primary">{{ request_success_rate }}%</span>
                            </div>
                            <div class="progress progress-slim bg-light-success">
                                <div class="progress-bar bg-success" role="progressbar" style="width: {{ request_success_rate }}%;" aria-valuenow="{{ request_success_rate }}" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                        <!--end::Progress-->
                    </div>
                </div>
                <!--end::Card body-->
            </div>
            <!--end::Card widget-->
    </div>
    <!--end::Col-->
    <!--begin::Col-->
    <div class="col-md-12 col-lg-6">
        <!--begin::Recent Activities Card-->
        <div class="card dashboard-card h-100">
            <!--begin::Header-->
            <div class="card-header border-0 pt-5">
                <div class="d-flex align-items-center">
                    <div class="d-inline-flex align-items-center justify-content-center bg-light-warning w-45px h-45px rounded-circle me-3">
                        <i class="ki-outline ki-notification fs-2 text-warning"></i>
                    </div>
                    <h3 class="card-title align-items-start flex-column m-0">
                        <span class="fw-bold text-dark">Son Kitap Aktiviteleri</span>
                        <span class="text-muted mt-1 fw-semibold fs-7">Kitaplar, ödünçler ve iadeler</span>
                    </h3>
                </div>
                <div class="card-toolbar">
                    <a href="{% url 'books:list' %}" class="btn btn-sm btn-light-primary px-4">
                        <i class="ki-outline ki-eye fs-7 me-1"></i>Tümünü Gör
                    </a>
                </div>
            </div>
            <!--end::Header-->
            <!--begin::Body-->
            <div class="card-body py-3">
                {% for activity in recent_activities %}
                <!--begin::Activity Item-->
                <div class="d-flex align-items-center mb-4">
                    <div class="symbol symbol-40px me-3 flex-shrink-0">
                        <div class="symbol-label fs-2 fw-bold rounded-circle bg-light-{{ activity.color }} text-{{ activity.color }}">
                            {{ activity.title|first }}
                        </div>
                    </div>
                    <div class="d-flex flex-column flex-grow-1">
                        <a href="{% url 'books:detail' activity.id %}" class="text-dark fw-bold text-hover-primary fs-6 mb-1">
                            {{ activity.title }}
                        </a>
                        <div class="d-flex align-items-center">
                            <span class="text-muted fw-semibold fs-7 me-3">{{ activity.author }}</span>
                            <span class="badge badge-light-{{ activity.color }} fs-8 fw-semibold">{{ activity.status }}</span>
                        </div>
                    </div>
                </div>
                {% if not forloop.last %}
                <div class="separator separator-dashed my-3"></div>
                {% endif %}
                {% endfor %}
            </div>
            <!--end::Body-->
        </div>
        <!--end::Recent Activities Card-->
    </div>
    <!--end::Col-->
</div>
<!--end::Row-->

<!--begin::Row-->
<div class="row g-4 mb-5">
    <!--begin::Col-->
    <div class="col-xl-8">
        <!--begin::Popular Books Card-->
        <div class="card dashboard-card h-xl-100">
            <!--begin::Card header-->
            <div class="card-header border-0 pt-5">
                <div class="d-flex align-items-center">
                    <div class="d-inline-flex align-items-center justify-content-center bg-light-success w-45px h-45px rounded-circle me-3">
                        <i class="ki-outline ki-medal fs-2 text-success"></i>
                    </div>
                    <h3 class="card-title align-items-start flex-column m-0">
                        <span class="fw-bold text-dark">En Popüler Kitaplar</span>
                        <span class="text-muted mt-1 fw-semibold fs-7">En çok ödünç alınan kitaplar</span>
                    </h3>
                </div>
                <div class="card-toolbar">
                    <a href="{% url 'books:list' %}" class="btn btn-sm btn-light-primary px-4">
                        <i class="ki-outline ki-eye fs-7 me-1"></i>Tümünü Gör
                    </a>
                </div>
            </div>
            <!--end::Card header-->
            <!--begin::Card body-->
            <div class="card-body">
                <!--begin::Table-->
                <table class="table align-middle table-row-dashed fs-6 gy-3" id="kt_table_widget_5_table">
                    <!--begin::Table head-->
                    <thead>
                        <!--begin::Table row-->
                        <tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0">
                            <th class="min-w-150px">Kitap</th>
                            <th class="text-end pe-3 min-w-100px">Kütüphane</th>
                            <th class="text-end pe-3 min-w-100px">Durum</th>
                            <th class="text-end pe-3 min-w-100px">Toplam Ödünç</th>
                            <th class="text-end pe-0 min-w-75px">İşlemler</th>
                        </tr>
                        <!--end::Table row-->
                    </thead>
                    <!--end::Table head-->
                    <!--begin::Table body-->
                    <tbody class="fw-bold text-gray-600">
                        {% for book in popular_books %}
                        <tr>
                            <td class="d-flex align-items-center">
                                <div class="symbol symbol-50px me-3">
                                    {% if book.cover_image %}
                                    <img src="{{ book.cover_image.url }}" class="" alt="Book Cover" />
                                    {% else %}
                                    <div class="symbol-label fs-2 fw-semibold bg-primary text-inverse-primary">{{ book.title|first }}</div>
                                    {% endif %}
                                </div>
                                <div class="d-flex justify-content-start flex-column">
                                    <a href="{% url 'books:detail' book.id %}" class="text-dark fw-bold text-hover-primary mb-1 fs-6">{{ book.title }}</a>
                                    <span class="text-muted fw-semibold text-muted d-block fs-7">{{ book.author }}</span>
                                </div>
                            </td>
                            <td class="text-end">
                                <a href="{% url 'libraries:detail' book.library.id %}" class="text-dark fw-bold text-hover-primary d-block mb-1 fs-6">{{ book.library.name }}</a>
                            </td>
                            <td class="text-end">
                                <span class="badge badge-light-{{ book.status_color }} fs-7 fw-bold">{{ book.get_status_display }}</span>
                            </td>
                            <td class="text-end">
                                <span class="text-dark fw-bold d-block mb-1 fs-6">{{ book.loan_count }}</span>
                            </td>
                            <td class="text-end">
                                <a href="{% url 'books:detail' book.id %}" class="btn btn-icon btn-bg-light btn-active-color-primary btn-sm me-1">
                                    <i class="ki-outline ki-eye fs-2"></i>
                                </a>
                                {% if book.status == 'available' %}
                                <a href="{% url 'loans:borrow' book.id %}" class="btn btn-icon btn-bg-light btn-active-color-success btn-sm me-1">
                                    <i class="ki-outline ki-arrow-right fs-2"></i>
                                </a>
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                    <!--end::Table body-->
                </table>
                <!--end::Table-->
            </div>
            <!--end::Card body-->
        </div>
        <!--end::Table Widget 5-->
    </div>
    <!--end::Col-->
    <!--begin::Col-->
    <div class="col-xl-4">
        <!--begin::Your Loans Card-->
        <div class="card dashboard-card h-xl-100">
            <!--begin::Header-->
            <div class="card-header border-0 pt-5">
                <div class="d-flex align-items-center">
                    <div class="d-inline-flex align-items-center justify-content-center bg-light-info w-45px h-45px rounded-circle me-3">
                        <i class="ki-outline ki-calendar fs-2 text-info"></i>
                    </div>
                    <h3 class="card-title align-items-start flex-column m-0">
                        <span class="fw-bold text-dark">Kitap Ödünçleriniz</span>
                        <span class="text-muted mt-1 fw-semibold fs-7">{{ active_loans }} aktif ödünç</span>
                    </h3>
                </div>
                <div class="card-toolbar">
                    <a href="{% url 'loans:my_loans' %}" class="btn btn-sm btn-light-primary px-4">
                        <i class="ki-outline ki-eye fs-7 me-1"></i>Tümünü Gör
                    </a>
                </div>
            </div>
            <!--end::Header-->
            <!--begin::Body-->
            <div class="card-body pt-4">
                {% for loan in user_loans %}
                <!--begin::Item-->
                <div class="d-flex flex-stack">
                    <!--begin::Content-->
                    <div class="d-flex align-items-center me-5">
                        <!--begin::Symbol-->
                        <div class="symbol symbol-40px me-4">
                            {% if loan.book.cover_image %}
                            <img src="{{ loan.book.cover_image.url }}" class="" alt="Book Cover" />
                            {% else %}
                            <div class="symbol-label fs-2 fw-semibold bg-{{ loan.status_color }} text-inverse-{{ loan.status_color }}">{{ loan.book.title|first }}</div>
                            {% endif %}
                        </div>
                        <!--end::Symbol-->
                        <!--begin::Section-->
                        <div class="me-2">
                            <a href="{% url 'books:detail' loan.book.id %}" class="text-gray-800 text-hover-primary fs-6 fw-bold">{{ loan.book.title }}</a>
                            <span class="text-gray-500 fw-semibold d-block fs-7">{{ loan.book.author }}</span>
                        </div>
                        <!--end::Section-->
                    </div>
                    <!--end::Content-->
                    <!--begin::Wrapper-->
                    <div class="d-flex align-items-center">
                        <!--begin::Number-->
                        <span class="text-gray-800 fw-bold fs-6 me-3">Son Tarih: {{ loan.due_date|date:"d M" }}</span>
                        <!--end::Number-->
                        <!--begin::Info-->
                        <div class="m-0">
                            <span class="badge badge-light-{{ loan.status_color }} fs-8 fw-bold">{{ loan.get_status_display }}</span>
                        </div>
                        <!--end::Info-->
                    </div>
                    <!--end::Wrapper-->
                </div>
                <!--end::Item-->
                <!--begin::Separator-->
                <div class="separator separator-dashed my-3"></div>
                <!--end::Separator-->
                {% endfor %}
            </div>
            <!--end::Body-->
        </div>
        <!--end::List widget 11-->
    </div>
    <!--end::Col-->
</div>
<!--end::Row-->
{% endblock %}

{% block extra_js %}
<script>
    // Grafikleri ve diğer gösterge paneli öğelerini başlat
    $(document).ready(function () {
        // Kitap Durumu Grafiği
        var el = document.getElementById('kt_card_widget_17_chart');
        if (el) {
            var options = {
                size: parseInt(el.getAttribute('data-kt-size')),
                lineWidth: parseInt(el.getAttribute('data-kt-line')),
                rotate: parseInt(el.getAttribute('data-kt-rotate')),
                color: el.getAttribute('data-kt-color') || '#3E97FF'
            };
            
            var canvas = document.createElement('canvas');
            var span = document.createElement('span');
                
            if (typeof(G_vmlCanvasManager) !== 'undefined') {
                G_vmlCanvasManager.initElement(canvas);
            }
                
            var ctx = canvas.getContext('2d');
            canvas.width = canvas.height = options.size;
                
            el.appendChild(span);
            el.appendChild(canvas);
                
            ctx.translate(options.size / 2, options.size / 2); // change center
            ctx.rotate((-1 / 2 + options.rotate / 180) * Math.PI); // rotate -90 deg
                
            var radius = (options.size - options.lineWidth) / 2;
                
            // Draw available books arc
            var availablePercentage = {{ available_percentage|default:0 }} / 100;
            var drawArc = function(color, lineWidth, percentage) {
                percentage = Math.min(Math.max(0, percentage || 1), 1);
                ctx.beginPath();
                ctx.arc(0, 0, radius, 0, Math.PI * 2 * percentage, false);
                ctx.strokeStyle = color;
                ctx.lineCap = 'round'; // butt, round or square
                ctx.lineWidth = lineWidth;
                ctx.stroke();
            };
                
            // Arka plan yayını çiz
            drawArc('#E4E6EF', options.lineWidth, 100 / 100);
            // Başarı yayını çiz
            drawArc('#50CD89', options.lineWidth, availablePercentage);
        }
        
        // Ödünç Durumu Grafiği
        var el2 = document.getElementById('kt_card_widget_7_chart');
        if (el2) {                var options2 = {
                series: [{
                    name: 'Aktif Ödünçler',
                    data: {{ loan_data|safe }}
                }],
                chart: {
                    type: 'area',
                    height: 150,
                    toolbar: {
                        show: false
                    },
                    zoom: {
                        enabled: false
                    },
                    sparkline: {
                        enabled: true
                    }
                },
                plotOptions: {},
                legend: {
                    show: false
                },
                dataLabels: {
                    enabled: false
                },
                fill: {
                    type: 'solid',
                    opacity: 1
                },
                stroke: {
                    curve: 'smooth',
                    show: true,
                    width: 3,
                    colors: ['#20D489']
                },
                xaxis: {
                    categories: {{ loan_dates|safe }},
                    axisBorder: {
                        show: false,
                    },
                    axisTicks: {
                        show: false
                    },
                    labels: {
                        show: false,
                        style: {
                            colors: '#A1A5B7',
                            fontSize: '12px'
                        }
                    },
                    crosshairs: {
                        show: false,
                        position: 'front',
                        stroke: {
                            color: '#E4E6EF',
                            width: 1,
                            dashArray: 3
                        }
                    },
                    tooltip: {
                        enabled: false
                    }
                },
                yaxis: {
                    min: 0,
                    max: {{ max_loan_value|default:5 }},
                    labels: {
                        show: false,
                        style: {
                            colors: '#A1A5B7',
                            fontSize: '12px'
                        }
                    }
                },
                states: {
                    normal: {
                        filter: {
                            type: 'none',
                            value: 0
                        }
                    },
                    hover: {
                        filter: {
                            type: 'none',
                            value: 0
                        }
                    },
                    active: {
                        allowMultipleDataPointsSelection: false,
                        filter: {
                            type: 'none',
                            value: 0
                        }
                    }
                },
                tooltip: {
                    style: {
                        fontSize: '12px'
                    },
                    y: {
                        formatter: function (val) {
                            return val + " ödünç"
                        }
                    }
                },
                colors: ['#20D489'],
                markers: {
                    colors: ['#20D489'],
                    strokeColor: ['#20D489'],
                    strokeWidth: 3
                }
            };
    
            var chart = new ApexCharts(el2, options2);
            chart.render();
        }
    });
</script>
{% endblock %}
